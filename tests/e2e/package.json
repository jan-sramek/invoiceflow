{
  "name": "invoiceflow-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for InvoiceFlow, run against the k3d deployment",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
